#include <stdio.h>
void myfunction(){
    int localVar = 10;
//A local variable in C is a variable that is declared within a function or a block of code and is only accessible within that function or block. It is created when the function or block is entered and destroyed when the function or block is exited. Local variables are stored in the stack memory and have automatic storage duration, meaning they are automatically allocated and deallocated by the compiler.
    printf("the local variable is:%d\n", localVar);
}
int main(){
    myfunction();
    return 0;
}
#include <stdio.h>
int globalvar = 20;
//A global variable in C is a variable that is declared outside of any function, usually at the top of the program, and is accessible from any function within the program. Global variables have a static storage duration, meaning they are allocated when the program starts and deallocated when the program ends. They are stored in the data segment of the memory.
void myfunction(){
    printf("global variable in my function: %d\n",globalvar);
}
int main(){
    printf("global variable in main function: %d\n",globalvar);
 myfunction();
    return 0;
}
#include <stdio.h>

int main() {
    int uninitializedVar; // declared but not initialized
    printf("Garbage value: %d\n", uninitializedVar);
    //a garbage value refers to the random, unpredictable value that a variable holds before it has been explicitly initialized
    return 0;
}
#include <stdio.h>
//To avoid garbage values, it's a good practice to always initialize variables when you declare them
int main() {
    int initializedVar = 0; // declared and initialized
    printf("Initialized value: %d\n", initializedVar);
    return 0;
}
#include <stdio.h>
int main(){
    //A pointer is a variable that stores the memory address of another variable. Instead of holding a value directly, a pointer holds the address where the value is stored.
    int var = 10;
    int *ptr;
    ptr = &var;
    printf("value of var: %d\n",var);
    printf("address of var: %p\n",&var);
    printf("value of ptr: %p\n", ptr);
    printf("value pointed to by ptr: %d\n", *ptr);
    return 0;
}
