//Example 1: Sum of Array Elements
#include <stdio.h>
int main(){
    int num[5] = {10, 20, 30, 40, 50};
    int sum = 0;
    for(int i = 0; i<5; i++){
        sum +=num[i];
    }
    printf("sum of array element: %d\n", sum);
    
       return 0;
}
