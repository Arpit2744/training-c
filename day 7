#include<string.h>
void reversestr(){
    char so[50];
    printf("enter the string: ");
    scanf("%s", &so);
    
    int n = strlen(so);
    for(int i=0; i<n/2; i++){
        char bonn = so[i];
        so[i] = so[n-i-1];
        so[n-i-1] = bonn;
    }
    printf("reverse string is: %s\n", so);
}
    int main(){
        reversestr();
        return 0;
