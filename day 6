        for (j = 0; j < 4; j++) {// for column
            scanf("%d", &a[i][j]);
        }
    }
    for (i = 0; i < 2; i++) {
        for (j = 0; j < 4; j++) {
            t[j][i]=a[i][j];
        }
    }
    printf("Elements of the array a: \n");
    for (i = 0; i < 2; i++) {
        for (j = 0; j < 4; j++) {
         printf("%d ", a[i][j]);
        }
        printf("\n");
    }
    printf("transpose of a: \n");
    for (i = 0; i < 4; i++) {
        for (j = 0; j < 2; j++) {
         printf("%d ", t[i][j]);
        }
