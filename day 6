#include <stdio.h>
int main(){
    int n1, n2;
    printf("enter two number: ", &n1, &n2);
    scanf("%d%d", &n1, &n2);
    if(n1>n2){
        printf("%d is greater then %d", n1, n2);
    }
    else if(n2>n1){
        printf("%d is greater then %d", n2, n1);
    }
    else{
        printf("%d and %d are equal", n1, n2);
    }
    return 0;
}
