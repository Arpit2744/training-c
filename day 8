#include<stdio.h>
int linear(int ben[], int size, int key){
    for(int i = 0; i < size; i++){
        if (ben[i] == key){
            return i;
        }
    } return -1;
}
int main(){
    int ben[] = {1,2,3,4,5};
    int size = sizeof(ben)/ sizeof(ben[0]);
    /* sizeof(ben) gives the total size of the array in bytes.
sizeof(ben[0]) gives the size of the first element in the array in bytes.
Dividing the total size of the array by the size of one element gives the number of elements in the array. */
    int key = 6;
    int result = linear(ben, size, key);
    if (result != -1){
        printf("element found at index %d\n", result);
    }
    else{
        printf("nahi hai isme \n");
    }
    return 0;
}
#include <stdio.h>
int binary(int arr[], int size, int key){
    int low = 0, high = size -1;
    while(low<= high){
        int mid = (low + high)/2;
        if(arr[mid]==key){
            return mid;
        }
        else if(arr[mid]<key){
            low = mid + 1;
        }
        else{
            high = mid - 1; 
        }
    }
        return -1;
    }
